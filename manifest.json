{
  "manifest_version": 3,
  "name": "Kibana JSON Message Formatter",
  "key": "",
  "version": "1.4",
  "description": "Parses JSON in the 'message' field of Kibana logs and displays it formatted.",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["https://*/app/discover*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
